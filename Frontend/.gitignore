# ==== FRONTEND: Angular ====

# Node.js dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Angular build output
dist/
out-tsc/
.angular/

# Angular environment files (si usás variables sensibles)
.env
.env.*

# IDE files
.vscode/
.idea/


# ==== BACKEND: Django (Python) ====

# Bytecode y caché de Python
__pycache__/
*.py[cod]
*$py.class

# Archivos de entorno
.env
.env.*

# Base de datos SQLite (no aplica a MySQL, pero por si acaso)
*.sqlite3
db.sqlite3

# Archivos de logs
*.log

# Archivos de traducción temporales
*.pot

# Virtualenvs
venv/
.venv/
ENV/
env/
.ENV/

# Archivos de migración (opcional ignorarlos)
**/migrations/*.py
!**/migrations/__init__.py

# Archivos de configuración de PyCharm/VSCode
.idea/
.vscode/

# Archivos temporales del sistema
.DS_Store
Thumbs.db

# Backup y archivos swp de editores
*~
*.swp

# ==== DJANGO STATIC/MEDIA ====
media/
staticfiles/
static/
